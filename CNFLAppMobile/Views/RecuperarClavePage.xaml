<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CNFLAppMobile.Views.RecuperarClavePage"
             Title="Recuperar Contraseña"
             BackgroundColor="#F2F4F8">

    <ScrollView>
        <StackLayout Padding="30" Spacing="16" VerticalOptions="Center">

            <!-- Título -->
            <StackLayout HorizontalOptions="Center" Spacing="4" Margin="0,0,0,16">
                <Label Text="🔑"
                       FontSize="32"
                       HorizontalOptions="Center" />
                <Label Text="Recuperar contraseña"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#0E1116"
                       HorizontalOptions="Center" />
                <Label Text="Te enviaremos un enlace a tu correo"
                       FontSize="14"
                       TextColor="#727A86"
                       HorizontalOptions="Center" />
            </StackLayout>

            <!-- Correo -->
            <Label Text="CORREO ELECTRÓNICO"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   TextTransform="Uppercase" />
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Opacity="0.04"
                            Radius="8"
                            Offset="0,2" />
                </Border.Shadow>
                <Entry x:Name="EntryCorreo"
                       Placeholder="usuario@correo.com"
                       FontSize="16"
                       TextColor="#0E1116"
                       BackgroundColor="Transparent"
                       Margin="16,14">
                    <Entry.PlaceholderColor>
                        <Color>#B0B8C5</Color>
                    </Entry.PlaceholderColor>
                </Entry>
            </Border>

            <!-- Botón Enviar -->
            <Button x:Name="BtnEnviar"
                    Text="Enviar enlace de recuperación"
                    BackgroundColor="#1E23E6"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,12,0,0"
                    Clicked="OnEnviarClicked">
                <Button.Shadow>
                    <Shadow Brush="#1E23E6"
                            Opacity="0.25"
                            Radius="12"
                            Offset="0,4" />
                </Button.Shadow>
            </Button>

            <!-- Volver a Login -->
            <StackLayout HorizontalOptions="Center" Spacing="4" Margin="0,16,0,0">
                <Label Text="¿Recordaste tu contraseña?"
                       FontSize="13"
                       TextColor="#727A86"
                       HorizontalOptions="Center" />
                <Label Text="Volver al inicio de sesión"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#FF692D"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverLoginTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>