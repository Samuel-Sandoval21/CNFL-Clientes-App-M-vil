<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CNFLAppMobile.Views.RegistroPage"
             Title="Registro"
             BackgroundColor="#F2F4F8">

    <ScrollView>
        <StackLayout Padding="30" Spacing="12">

            <!-- Título -->
            <StackLayout HorizontalOptions="Center" Spacing="4" Margin="0,0,0,16">
                <Label Text="📝"
                       FontSize="32"
                       HorizontalOptions="Center" />
                <Label Text="Crear cuenta"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#0E1116"
                       HorizontalOptions="Center" />
                <Label Text="Completa tus datos para comenzar"
                       FontSize="14"
                       TextColor="#727A86"
                       HorizontalOptions="Center" />
            </StackLayout>

            <!-- Nombre completo -->
            <Label Text="NOMBRE COMPLETO"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   TextTransform="Uppercase" />
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="0">
                <Entry x:Name="EntryNombre"
                       Placeholder="Ej: Juan Pérez"
                       FontSize="16"
                       TextColor="#0E1116"
                       BackgroundColor="Transparent"
                       Margin="16,14">
                    <Entry.PlaceholderColor>
                        <Color>#B0B8C5</Color>
                    </Entry.PlaceholderColor>
                </Entry>
            </Border>

            <!-- Cédula -->
            <Label Text="CÉDULA"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   TextTransform="Uppercase" />
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="0">
                <Entry x:Name="EntryCedula"
                       Placeholder="1-2345-6789"
                       FontSize="16"
                       TextColor="#0E1116"
                       BackgroundColor="Transparent"
                       Margin="16,14">
                    <Entry.PlaceholderColor>
                        <Color>#B0B8C5</Color>
                    </Entry.PlaceholderColor>
                </Entry>
            </Border>

            <!-- Teléfono -->
            <Label Text="TELÉFONO"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   TextTransform="Uppercase" />
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="0">
                <Entry x:Name="EntryTelefono"
                       Placeholder="8888-8888"
                       FontSize="16"
                       TextColor="#0E1116"
                       BackgroundColor="Transparent"
                       Margin="16,14">
                    <Entry.PlaceholderColor>
                        <Color>#B0B8C5</Color>
                    </Entry.PlaceholderColor>
                </Entry>
            </Border>

            <!-- Correo -->
            <Label Text="CORREO ELECTRÓNICO"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   TextTransform="Uppercase" />
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="0">
                <Entry x:Name="EntryCorreo"
                       Placeholder="usuario@correo.com"
                       FontSize="16"
                       TextColor="#0E1116"
                       BackgroundColor="Transparent"
                       Margin="16,14">
                    <Entry.PlaceholderColor>
                        <Color>#B0B8C5</Color>
                    </Entry.PlaceholderColor>
                </Entry>
            </Border>

            <!-- Usuario -->
            <Label Text="USUARIO"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   TextTransform="Uppercase" />
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="0">
                <Entry x:Name="EntryUsuario"
                       Placeholder="Elige un usuario"
                       FontSize="16"
                       TextColor="#0E1116"
                       BackgroundColor="Transparent"
                       Margin="16,14">
                    <Entry.PlaceholderColor>
                        <Color>#B0B8C5</Color>
                    </Entry.PlaceholderColor>
                </Entry>
            </Border>

            <!-- Contraseña -->
            <Label Text="CONTRASEÑA"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   TextTransform="Uppercase" />
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="0">
                <Grid>
                    <Entry x:Name="EntryContrasena"
                           Placeholder="Mínimo 6 caracteres"
                           IsPassword="True"
                           FontSize="16"
                           TextColor="#0E1116"
                           BackgroundColor="Transparent"
                           Margin="16,14">
                        <Entry.PlaceholderColor>
                            <Color>#B0B8C5</Color>
                        </Entry.PlaceholderColor>
                    </Entry>
                    <Button x:Name="BtnTogglePassword"
                            Text="👁️"
                            BackgroundColor="Transparent"
                            WidthRequest="44"
                            HeightRequest="44"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Clicked="OnTogglePasswordClicked" />
                </Grid>
            </Border>

            <!-- Confirmar contraseña -->
            <Label Text="CONFIRMAR CONTRASEÑA"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   TextTransform="Uppercase" />
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="0">
                <Grid>
                    <Entry x:Name="EntryConfirmarContrasena"
                           Placeholder="Repite la contraseña"
                           IsPassword="True"
                           FontSize="16"
                           TextColor="#0E1116"
                           BackgroundColor="Transparent"
                           Margin="16,14">
                        <Entry.PlaceholderColor>
                            <Color>#B0B8C5</Color>
                        </Entry.PlaceholderColor>
                    </Entry>
                    <Button x:Name="BtnToggleConfirm"
                            Text="👁️"
                            BackgroundColor="Transparent"
                            WidthRequest="44"
                            HeightRequest="44"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Clicked="OnToggleConfirmClicked" />
                </Grid>
            </Border>

            <!-- Botón Registrarse -->
            <Button x:Name="BtnRegistrarse"
                    Text="Registrarse"
                    BackgroundColor="#FF692D"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,12,0,0"
                    Clicked="OnRegistrarseClicked">
                <Button.Shadow>
                    <Shadow Brush="#FF692D"
                            Opacity="0.25"
                            Radius="12"
                            Offset="0,4" />
                </Button.Shadow>
            </Button>

            <!-- Login -->
            <StackLayout HorizontalOptions="Center" Spacing="4" Margin="0,12,0,0">
                <Label Text="¿Ya tienes cuenta?"
                       FontSize="13"
                       TextColor="#727A86"
                       HorizontalOptions="Center" />
                <Label Text="Inicia sesión aquí"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#1E23E6"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>