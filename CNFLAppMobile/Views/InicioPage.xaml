<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CNFLAppMobile.Views.InicioPage"
             Title="Inicio"
             BackgroundColor="#F2F4F8">

    <ScrollView>
        <StackLayout Padding="20" Spacing="16">

            <!-- ===== HEADER ===== -->
            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                <!-- Avatar -->
                <Border Grid.Column="0"
                        Grid.RowSpan="2"
                        BackgroundColor="#1E23E6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        WidthRequest="50"
                        HeightRequest="50"
                        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#1E23E6"
                                Opacity="0.2"
                                Radius="8"
                                Offset="0,2" />
                    </Border.Shadow>
                    <Label Text="KV"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Saludo -->
                <StackLayout Grid.Column="1" Grid.Row="0">
                    <Label Text="Buenos días 👋"
                           FontSize="14"
                           TextColor="#727A86" />
                </StackLayout>
                <Label Grid.Column="1"
                       Grid.Row="1"
                       Text="Katherine Villalobos"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#0E1116" />

                <!-- Notificaciones -->
                <Border Grid.Column="2"
                        Grid.RowSpan="2"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        WidthRequest="44"
                        HeightRequest="44"
                        VerticalOptions="Center"
                        HorizontalOptions="End">
                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Opacity="0.04"
                                Radius="8"
                                Offset="0,2" />
                    </Border.Shadow>
                    <Grid>
                        <Label Text="🔔"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Border BackgroundColor="#FF692D"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,4,4,0">
                            <Label Text="3"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== FACTURA PENDIENTE ===== -->
            <Border BackgroundColor="#1E23E6"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="20"
                    Margin="0,8,0,0">
                <Border.Shadow>
                    <Shadow Brush="#1E23E6"
                            Opacity="0.25"
                            Radius="20"
                            Offset="0,8" />
                </Border.Shadow>
                <StackLayout>
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="📄"
                               FontSize="20"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="FACTURA PENDIENTE"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="White"
                               Opacity="0.7"
                               VerticalOptions="Center"
                               Margin="10,0,0,0" />
                    </Grid>
                    <Label Text="₡ 18.450"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="0,6,0,2" />
                    <Label Text="Vence el 28 de agosto · NISE 4021"
                           FontSize="13"
                           TextColor="White"
                           Opacity="0.75" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,16,0,0">
                        <Button x:Name="BtnVerDetalle"
                                Text="Ver detalle"
                                BackgroundColor="Transparent"
                                BorderColor="White"
                                BorderWidth="1"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="44"
                                Clicked="OnVerDetalleClicked" />
                        <Button x:Name="BtnPagarAhora"
                                Grid.Column="1"
                                Text="Pagar ahora"
                                BackgroundColor="#FF692D"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="44"
                                Clicked="OnPagarAhoraClicked" />
                    </Grid>
                </StackLayout>
            </Border>

            <!-- ===== MIS SERVICIOS ===== -->
            <Label Text="MIS SERVICIOS"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   Margin="0,8,0,4"
                   TextTransform="Uppercase" />

            <!-- Servicio 1: Casa -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="14">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Opacity="0.04"
                            Radius="12"
                            Offset="0,4" />
                </Border.Shadow>
                <Grid ColumnDefinitions="44, *, Auto" RowDefinitions="Auto, Auto">
                    <Border BackgroundColor="#E8F5E9"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="44"
                            HeightRequest="44"
                            Grid.RowSpan="2">
                        <Label Text="⚡"
                               FontSize="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <StackLayout Grid.Column="1" Margin="12,0,0,0">
                        <Label Text="Casa · NISE 4021"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <Label Text="Residencial · San José"
                               FontSize="12"
                               TextColor="#727A86" />
                    </StackLayout>
                    <Border Grid.Column="2"
                            Grid.Row="0"
                            BackgroundColor="#E8F5E9"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="8,4"
                            VerticalOptions="Start">
                        <Label Text="Normal"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#2E7D32" />
                    </Border>
                    <Label Grid.Column="2"
                           Grid.Row="1"
                           Text="›"
                           FontSize="18"
                           TextColor="#C3C8D4"
                           HorizontalOptions="End"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Servicio 2: Local -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="14">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Opacity="0.04"
                            Radius="12"
                            Offset="0,4" />
                </Border.Shadow>
                <Grid ColumnDefinitions="44, *, Auto" RowDefinitions="Auto, Auto">
                    <Border BackgroundColor="#FFF8E1"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="44"
                            HeightRequest="44"
                            Grid.RowSpan="2">
                        <Label Text="🏪"
                               FontSize="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <StackLayout Grid.Column="1" Margin="12,0,0,0">
                        <Label Text="Local · NISE 7788"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <Label Text="Mantenimiento programado 2:00pm"
                               FontSize="12"
                               TextColor="#727A86" />
                    </StackLayout>
                    <Border Grid.Column="2"
                            Grid.Row="0"
                            BackgroundColor="#FFF8E1"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="8,4"
                            VerticalOptions="Start">
                        <Label Text="Prevención"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#B9791A" />
                    </Border>
                    <Label Grid.Column="2"
                           Grid.Row="1"
                           Text="›"
                           FontSize="18"
                           TextColor="#C3C8D4"
                           HorizontalOptions="End"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Servicio 3: Finca -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="14">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Opacity="0.04"
                            Radius="12"
                            Offset="0,4" />
                </Border.Shadow>
                <Grid ColumnDefinitions="44, *, Auto" RowDefinitions="Auto, Auto">
                    <Border BackgroundColor="#FFEBEE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="44"
                            HeightRequest="44"
                            Grid.RowSpan="2">
                        <Label Text="🌳"
                               FontSize="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <StackLayout Grid.Column="1" Margin="12,0,0,0">
                        <Label Text="Finca · NISE 9950"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <Label Text="Avería en la red · atendiéndose"
                               FontSize="12"
                               TextColor="#727A86" />
                    </StackLayout>
                    <Border Grid.Column="2"
                            Grid.Row="0"
                            BackgroundColor="#FFEBEE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="8,4"
                            VerticalOptions="Start">
                        <Label Text="Incidente"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#C62828" />
                    </Border>
                    <Label Grid.Column="2"
                           Grid.Row="1"
                           Text="›"
                           FontSize="18"
                           TextColor="#C3C8D4"
                           HorizontalOptions="End"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- ===== CONSUMO ===== -->
            <Label Text="CONSUMO ELÉCTRICO"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   Margin="0,8,0,4"
                   TextTransform="Uppercase" />

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Opacity="0.04"
                            Radius="12"
                            Offset="0,4" />
                </Border.Shadow>
                <StackLayout>
                    <Grid ColumnDefinitions="*, *, *, *, *, *"
                          RowDefinitions="Auto"
                          HeightRequest="120"
                          Margin="0,4,0,8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <Border BackgroundColor="#64B9CD"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    HeightRequest="55"
                                    WidthRequest="28"
                                    HorizontalOptions="Center" />
                            <Label Text="Ene"
                                   FontSize="10"
                                   TextColor="#727A86" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <Border BackgroundColor="#64B9CD"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    HeightRequest="75"
                                    WidthRequest="28"
                                    HorizontalOptions="Center" />
                            <Label Text="Feb"
                                   FontSize="10"
                                   TextColor="#727A86" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                            <Border BackgroundColor="#64B9CD"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    HeightRequest="65"
                                    WidthRequest="28"
                                    HorizontalOptions="Center" />
                            <Label Text="Mar"
                                   FontSize="10"
                                   TextColor="#727A86" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                            <Border BackgroundColor="#64B9CD"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    HeightRequest="85"
                                    WidthRequest="28"
                                    HorizontalOptions="Center" />
                            <Label Text="Abr"
                                   FontSize="10"
                                   TextColor="#727A86" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
                            <Border BackgroundColor="#64B9CD"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    HeightRequest="70"
                                    WidthRequest="28"
                                    HorizontalOptions="Center" />
                            <Label Text="May"
                                   FontSize="10"
                                   TextColor="#727A86" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="5" Spacing="4" HorizontalOptions="Center">
                            <Border BackgroundColor="#1E23E6"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    HeightRequest="100"
                                    WidthRequest="28"
                                    HorizontalOptions="Center" />
                            <Label Text="Jun"
                                   FontSize="10"
                                   TextColor="#727A86" />
                        </VerticalStackLayout>
                    </Grid>

                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="BtnPeriodo6M"
                                Text="6 meses"
                                BackgroundColor="#1E23E6"
                                TextColor="White"
                                CornerRadius="16"
                                Padding="14,6"
                                FontSize="11"
                                FontAttributes="Bold"
                                Clicked="OnPeriodoClicked" />
                        <Button x:Name="BtnPeriodo31D"
                                Text="31 días"
                                BackgroundColor="#EEF0F7"
                                TextColor="#727A86"
                                CornerRadius="16"
                                Padding="14,6"
                                FontSize="11"
                                FontAttributes="Bold"
                                Clicked="OnPeriodoClicked" />
                        <Button x:Name="BtnPeriodoLecturas"
                                Text="Lecturas"
                                BackgroundColor="#EEF0F7"
                                TextColor="#727A86"
                                CornerRadius="16"
                                Padding="14,6"
                                FontSize="11"
                                FontAttributes="Bold"
                                Clicked="OnPeriodoClicked" />
                    </HorizontalStackLayout>
                </StackLayout>
            </Border>

            <!-- ===== CONSULTA AL MEDIDOR ===== -->
            <Label Text="CONSULTA AL MEDIDOR"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#727A86"
                   Margin="0,8,0,4"
                   TextTransform="Uppercase" />

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Opacity="0.04"
                            Radius="12"
                            Offset="0,4" />
                </Border.Shadow>
                <StackLayout>
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="10">
                        <Border Grid.Column="0" Grid.Row="0"
                                BackgroundColor="#F7F8FC"
                                StrokeThickness="0"
                                Padding="12"
                                StrokeShape="RoundRectangle 12">
                            <StackLayout>
                                <Label Text="Última lectura"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#727A86" />
                                <Label Text="742 kWh"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                            </StackLayout>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="0"
                                BackgroundColor="#F7F8FC"
                                StrokeThickness="0"
                                Padding="12"
                                StrokeShape="RoundRectangle 12">
                            <StackLayout>
                                <Label Text="Acumulado del mes"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#727A86" />
                                <Label Text="198 kWh"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                            </StackLayout>
                        </Border>
                        <Border Grid.Column="0" Grid.Row="1"
                                BackgroundColor="#F7F8FC"
                                StrokeThickness="0"
                                Padding="12"
                                StrokeShape="RoundRectangle 12">
                            <StackLayout>
                                <Label Text="Costo estimado"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#727A86" />
                                <Label Text="₡ 21.300"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#FF692D" />
                            </StackLayout>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="1"
                                BackgroundColor="#F7F8FC"
                                StrokeThickness="0"
                                Padding="12"
                                StrokeShape="RoundRectangle 12">
                            <StackLayout>
                                <Label Text="Promedio mensual"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#727A86" />
                                <Label Text="205 kWh"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                            </StackLayout>
                        </Border>
                    </Grid>

                    <Border BackgroundColor="#E8F5E9"
                            StrokeThickness="0"
                            Padding="12"
                            StrokeShape="RoundRectangle 12"
                            Margin="0,12,0,0">
                        <Label Text="✅ 12% menos que el mes anterior · ¡buen ahorro!"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#2E7D32"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </StackLayout>
            </Border>

        </StackLayout>
    </ScrollView>

</ContentPage>