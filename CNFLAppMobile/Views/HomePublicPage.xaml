<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CNFLAppMobile.Views.HomePublicPage"
             BackgroundColor="#F2F4F8">

    <ScrollView>
        <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Logo -->
            <StackLayout HorizontalOptions="Center" Spacing="4" Margin="0,0,0,20">
                <Label Text="⚡"
                       FontSize="48"
                       HorizontalOptions="Center" />
                <Label Text="CNFL"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="#FF692D"
                       HorizontalOptions="Center" />
                <Label Text="Tu energía, en una sola app"
                       FontSize="16"
                       TextColor="#727A86"
                       HorizontalOptions="Center" />
            </StackLayout>

            <!-- Características -->
            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *, *" ColumnSpacing="12" RowSpacing="12">
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <StackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="⚡"
                               FontSize="28"
                               HorizontalOptions="Center" />
                        <Label Text="Reporta Averías"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#0E1116"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <StackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="💳"
                               FontSize="28"
                               HorizontalOptions="Center" />
                        <Label Text="Paga tus facturas"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#0E1116"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="2"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <StackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="📊"
                               FontSize="28"
                               HorizontalOptions="Center" />
                        <Label Text="Consulta consumo"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#0E1116"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Border>
            </Grid>

            <!-- Botones -->
            <Button x:Name="BtnIniciarSesion"
                    Text="Iniciar Sesión"
                    BackgroundColor="#1E23E6"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,16,0,0"
                    Clicked="OnIniciarSesionClicked">
                <Button.Shadow>
                    <Shadow Brush="#1E23E6"
                            Opacity="0.25"
                            Radius="12"
                            Offset="0,4" />
                </Button.Shadow>
            </Button>

            <Button x:Name="BtnRegistrarse"
                    Text="Registrarse"
                    BackgroundColor="White"
                    TextColor="#1E23E6"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    BorderColor="#1E23E6"
                    BorderWidth="1.5"
                    Clicked="OnRegistrarseClicked" />

            <!-- Footer -->
            <Label Text="© 2026 CNFL · Todos los derechos reservados"
                   FontSize="11"
                   TextColor="#727A86"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0" />

        </StackLayout>
    </ScrollView>

</ContentPage>