<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CNFLAppMobile.Views.Public.HomePublicPage"
             Title="CNFL Clientes"
             BackgroundColor="#FFF8F3">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">

            <!-- Header con logo -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,40,0,0">
                <Image Source="logocnfl.png" 
                       HeightRequest="90" 
                       Aspect="AspectFit" 
                       HorizontalOptions="Center" />
                <Label Text="CNFL Clientes" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="#F47920" 
                       HorizontalTextAlignment="Center"/>
                <Label Text="Compañía Nacional de Fuerza y Luz" 
                       FontSize="12" 
                       TextColor="#7A5A3A" 
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Tarjeta de bienvenida -->
            <Border BackgroundColor="#FFFFFF" 
                    Padding="16"
                    StrokeThickness="1"
                    Stroke="#F0D0B0"
                    Margin="0,20,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="¡Bienvenido!" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#2A1A0A"/>
                    <Label Text="Accede a tu cuenta para consultar facturas, reportar averías y gestionar tus servicios eléctricos." 
                           FontSize="13" 
                           TextColor="#7A5A3A"/>
                </VerticalStackLayout>
            </Border>

            <!-- Botones de acción con diseño mejorado -->
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12" Margin="0,10,0,0">
                <Button Grid.Row="0" Grid.Column="0" 
                        Text="📱 Iniciar Sesión" 
                        BackgroundColor="#F47920" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="55"
                        Clicked="OnLoginClicked"/>

                <Button Grid.Row="0" Grid.Column="1" 
                        Text="📝 Registrarse" 
                        BackgroundColor="#1E23E6" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="55"
                        Clicked="OnRegistroClicked"/>

                <Button Grid.Row="1" Grid.Column="0" 
                        Text="❓ Recuperar Clave" 
                        BackgroundColor="#64B9CD" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="55"
                        Clicked="OnRecuperarClaveClicked"/>

                <Button Grid.Row="1" Grid.Column="1" 
                        Text="🗺️ Ver Mapa" 
                        BackgroundColor="#FF692D" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="55"
                        IsEnabled="False"/>
            </Grid>

            <!-- Footer -->
            <Label Text="© 2026 CNFL - Todos los derechos reservados" 
                   FontSize="11" 
                   TextColor="#BFA080" 
                   HorizontalTextAlignment="Center" 
                   Margin="0,30,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>