<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CNFLAppMobile.Views.Public.RegistroPage"
             Title="Registro"
             BackgroundColor="#FFF8F3">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="30,20,30,30">

            <Label Text="📝 Crear Cuenta" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#2A1A0A" 
                   HorizontalTextAlignment="Center"/>

            <Label Text="Completa tus datos para registrarte" 
                   FontSize="14" 
                   TextColor="#7A5A3A" 
                   HorizontalTextAlignment="Center"/>

            <!-- Nombre Completo -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Nombre Completo" FontSize="12" FontAttributes="Bold" TextColor="#7A5A3A"/>
                <Entry Placeholder="María González Pérez" 
                       BackgroundColor="#FFFFFF"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <!-- Cédula -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Cédula" FontSize="12" FontAttributes="Bold" TextColor="#7A5A3A"/>
                <Entry Placeholder="1 2345 6789" 
                       Keyboard="Numeric"
                       BackgroundColor="#FFFFFF"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <!-- Teléfono -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Teléfono" FontSize="12" FontAttributes="Bold" TextColor="#7A5A3A"/>
                <Entry Placeholder="8888-7777" 
                       Keyboard="Telephone"
                       BackgroundColor="#FFFFFF"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <!-- Correo -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Correo Electrónico" FontSize="12" FontAttributes="Bold" TextColor="#7A5A3A"/>
                <Entry Placeholder="maria@correo.com" 
                       Keyboard="Email"
                       BackgroundColor="#FFFFFF"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <!-- NISE -->
            <VerticalStackLayout Spacing="4">
                <Label Text="NISE (Número de Servicio Eléctrico)" FontSize="12" FontAttributes="Bold" TextColor="#7A5A3A"/>
                <Entry Placeholder="1234567-8" 
                       Keyboard="Numeric"
                       BackgroundColor="#FFFFFF"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <!-- Usuario -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Nombre de Usuario" FontSize="12" FontAttributes="Bold" TextColor="#7A5A3A"/>
                <Entry Placeholder="maria.gonzalez" 
                       BackgroundColor="#FFFFFF"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <!-- Contraseña -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Contraseña" FontSize="12" FontAttributes="Bold" TextColor="#7A5A3A"/>
                <Entry Placeholder="••••••••" 
                       IsPassword="True"
                       BackgroundColor="#FFFFFF"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <!-- Confirmar Contraseña -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Confirmar Contraseña" FontSize="12" FontAttributes="Bold" TextColor="#7A5A3A"/>
                <Entry Placeholder="••••••••" 
                       IsPassword="True"
                       BackgroundColor="#FFFFFF"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <!-- Botón Registrar -->
            <Button Text="Registrarse" 
                    BackgroundColor="#1E23E6" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    Margin="0,10,0,0"
                    Clicked="OnRegistroClicked"/>

            <!-- Validación TSE con Border en lugar de Frame -->
            <Border BackgroundColor="#E8F5E9" 
                    Padding="12"
                    StrokeThickness="1"
                    Stroke="#A5D6A7">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label Text="✅ Validación con el TSE" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="#2E7D32"/>
                    <Label Text="Al registrarte, tu cédula será validada con el Tribunal Supremo de Elecciones" 
                           FontSize="11" 
                           TextColor="#4CAF50"/>
                </VerticalStackLayout>
            </Border>

            <!-- Enlace a Login -->
            <Label HorizontalTextAlignment="Center" Margin="0,10,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="¿Ya tienes cuenta? " TextColor="#7A5A3A"/>
                        <Span Text="Inicia Sesión" TextColor="#F47920" FontAttributes="Bold">
                            <Span.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}"/>
                            </Span.GestureRecognizers>
                        </Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>