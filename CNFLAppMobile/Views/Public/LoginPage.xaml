<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CNFLAppMobile.Views.Public.LoginPage"
             Title="Iniciar Sesión"
             BackgroundColor="#FFF8F3">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="30,40,30,20">

            <Label Text="🔐 Iniciar Sesión" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#2A1A0A" 
                   HorizontalTextAlignment="Center"/>

            <Label Text="Ingresa con las credenciales de tu Agencia Virtual" 
                   FontSize="14" 
                   TextColor="#7A5A3A" 
                   HorizontalTextAlignment="Center"/>

            <!-- Campo: Cédula -->
            <VerticalStackLayout Spacing="4" Margin="0,20,0,0">
                <Label Text="Cédula" FontSize="12" FontAttributes="Bold" TextColor="#7A5A3A"/>
                <Entry x:Name="CedulaEntry" 
                       Placeholder="1 2345 6789" 
                       Keyboard="Numeric"
                       BackgroundColor="#FFFFFF"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <!-- Campo: Contraseña -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Contraseña" FontSize="12" FontAttributes="Bold" TextColor="#7A5A3A"/>
                <Entry x:Name="PasswordEntry" 
                       Placeholder="••••••••" 
                       IsPassword="True"
                       BackgroundColor="#FFFFFF"
                       HeightRequest="50"/>
            </VerticalStackLayout>

            <!-- Botón: Ingresar -->
            <Button Text="Ingresar" 
                    BackgroundColor="#F47920" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="OnLoginClicked"/>

            <!-- Métodos rápidos -->
            <Label Text="O ingresa con:" 
                   FontSize="12" 
                   TextColor="#7A5A3A" 
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Grid.Column="0" 
                        Text="👆 Face ID" 
                        BackgroundColor="#1E23E6" 
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="45"
                        Clicked="OnFaceIdClicked"/>

                <Button Grid.Column="1" 
                        Text="💬 WhatsApp" 
                        BackgroundColor="#25D366" 
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="45"
                        Clicked="OnWhatsAppClicked"/>

                <Button Grid.Column="2" 
                        Text="🏦 SINPE" 
                        BackgroundColor="#FF692D" 
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="45"
                        Clicked="OnSinpeClicked"/>
            </Grid>

            <!-- Enlaces -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,20,0,0">
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="¿Aún no tienes cuenta? " TextColor="#7A5A3A"/>
                            <Span Text="Regístrate aquí" TextColor="#F47920" FontAttributes="Bold">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToRegistroCommand}"/>
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="¿Olvidaste tu contraseña? " TextColor="#7A5A3A"/>
                            <Span Text="Recupérala" TextColor="#1E23E6" FontAttributes="Bold">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToRecuperarCommand}"/>
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <Label Text="Al iniciar sesión aceptas el Consentimiento Informado y la Política de Privacidad" 
                   FontSize="11" 
                   TextColor="#BFA080" 
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>